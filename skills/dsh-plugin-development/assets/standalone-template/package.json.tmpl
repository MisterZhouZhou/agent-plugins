{
  "name": "__PACKAGE_NAME__",
  "version": "0.1.0",
  "description": "__DESCRIPTION__",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "npm run build",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "import": "./lib/client.js",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": "__DSH_RANGE__"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-runtime"]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "__CORDIS_VERSION__",
    "@deepseek-ai/dsh-client-connection": "__SDK_VERSION__",
    "@types/node": "^22.0.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
